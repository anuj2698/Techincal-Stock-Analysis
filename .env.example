APP_ENV=development
ADMIN_SECRET=replace-with-a-long-random-value

FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_ACCESS_TOKEN=
FYERS_FY_ID=
FYERS_PIN=
FYERS_TOTP_SECRET=
FYERS_REDIRECT_URI=http://127.0.0.1:5001/fyers/callback

# Conservative round-trip allowance used by the backtest engine.
BACKTEST_EXECUTION_COST_PCT=0.15
BACKTEST_MIN_SAMPLE_SIZE=12

# V2 account-level guardrails. Tune deliberately after paper trading.
V2_RISK_PER_TRADE_PCT=0.5
V2_MAX_DAILY_LOSS_PCT=1.0
V2_MAX_TRADES_PER_DAY=3
V2_MAX_OPEN_POSITIONS=2
